Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "10"}]}], ")"}], " ", "Mallows", " ", "central"}], "-", 
    RowBox[{"winner", " ", 
     RowBox[{"robustness", ":", 
      RowBox[{
       RowBox[{"run", " ", 
        RowBox[{"experiment", "--"}]}], "-"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Running Mallows central-winner robustness sweep...\>\"",
      "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "runMallowsCentralReplication", "]"}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"runMallowsCentralReplication", "[", 
      RowBox[{"m_", ",", "n_", ",", "phi_", ",", "rep_"}], "]"}], ":=", 
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"SeedRandom", "[", 
        RowBox[{"Hash", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "mallowsBaseSeed", ",", "\"\<MallowsCentral\>\"", ",", "m", ",", 
            "n", ",", "phi", ",", "rep"}], "}"}], ",", "\"\<SHA256\>\""}], 
         "]"}], "]"}], ";", "\n", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"perm", ",", "prof", ",", "winners"}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "Mallows", " ", "profile", " ", "around", " ", "the", " ", "fixed",
             " ", "central", " ", "ranking", " ", "1"}], ",", "2", ",", "...",
            ",", "m"}], "*)"}], 
         RowBox[{
          RowBox[{"perm", "=", 
           RowBox[{"GenerateMallowsProfile", "[", 
            RowBox[{"m", ",", "n", ",", "phi", ",", 
             RowBox[{"Range", "[", "m", "]"}]}], "]"}]}], ";", "\n", 
          RowBox[{"prof", "=", 
           RowBox[{"MakeProfile", "[", "perm", "]"}]}], ";", "\n", 
          RowBox[{"winners", "=", 
           RowBox[{"WinnersAll", "[", 
            RowBox[{"prof", ",", "mallowsQ", ",", "mallowsP", ",", 
             RowBox[{"\"\<MaxRank\>\"", "->", "Automatic"}], ",", 
             RowBox[{"\"\<TieBreak\>\"", "->", "mallowsTieBreak"}]}], "]"}]}],
           ";", "\n", 
          RowBox[{"Association", "@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"rule", "->", 
              RowBox[{"Boole", "[", 
               RowBox[{
                RowBox[{"winners", "[", "rule", "]"}], "===", "1"}], "]"}]}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"rule", ",", "mallowsRules"}], "}"}]}], "]"}]}]}]}], 
        "]"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{
     "runMallowsCentralReplication", ",", "mallowsBaseSeed", ",", "mallowsQ", 
      ",", "mallowsP", ",", "mallowsTieBreak", ",", "mallowsRules", ",", 
      "GenerateMallowsProfile", ",", "MallowsSampleKendall", ",", 
      "MakeProfile", ",", "WinnersAll", ",", "WinnerBorda", ",", 
      "WinnerPlurality", ",", "WinnerCoombs", ",", "WinnerQRCompromise", ",", 
      "WinnerSDM", ",", "WinnerFallback", ",", "TieBreakPick", ",", 
      "TieKeyDefault", ",", "ArgMaxCandidates", ",", "ArgMinCandidates"}], 
     "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"mallowsCentralRaw", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "repResults", "}"}], ",", 
           RowBox[{
            RowBox[{"repResults", "=", 
             RowBox[{"ParallelTable", "[", 
              RowBox[{
               RowBox[{"runMallowsCentralReplication", "[", 
                RowBox[{"m", ",", "n", ",", "phi", ",", "rep"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"rep", ",", "1", ",", "mallowsS"}], "}"}]}], "]"}]}], 
            ";", "\n", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
                  RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
                  RowBox[{"\"\<phi\>\"", "->", "phi"}], ",", 
                  RowBox[{"\"\<Rule\>\"", "->", "rule"}], ",", 
                  RowBox[{"\"\<CentralWinnerRate\>\"", "->", 
                   RowBox[{"N", "@", 
                    RowBox[{"Mean", "[", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"repResults", ",", "rule"}], "]"}], "]"}]}]}]}], 
                 "|>"}], ",", 
                RowBox[{"{", 
                 RowBox[{"rule", ",", "mallowsRules"}], "}"}]}], "]"}], ",", 
              "1"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "mallowsMList"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "mallowsNList"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"phi", ",", "mallowsPhiList"}], "}"}]}], "]"}], ",", "3"}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Mallows central-winner sweep completed. Rows = \>\"", ",", 
      RowBox[{"Length", "[", "mallowsCentralRaw", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.995453096930252*^9, 3.9954531065370255`*^9}, {
  3.995460401857315*^9, 3.9954604024972935`*^9}},
