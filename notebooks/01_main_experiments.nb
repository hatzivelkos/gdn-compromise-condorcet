Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", "===", "===", "===", "===", "==="}], "="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"8", ")"}], " ", "Validate", " ", "exported", " ", "main", " ", 
    "experiment", " ", "data"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", "===", "===", "===", "==="}], "=", 
    RowBox[{"===", "===", "==="}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Validating exported main experiment data...\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "importCSVRows", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"importCSVRows", "[", "file_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"raw", ",", "header"}], "}"}], ",", 
       RowBox[{
        RowBox[{"raw", "=", 
         RowBox[{"Import", "[", 
          RowBox[{"file", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"header", "=", 
         RowBox[{"First", "[", "raw", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"AssociationThread", "[", 
           RowBox[{"header", ",", "#"}], "]"}], "&"}], "/@", 
         RowBox[{"Rest", "[", "raw", "]"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"mainFiles", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<IC\>\"", "->", "icFile"}], ",", 
       RowBox[{"\"\<Mallows\>\"", "->", "mallowsFile"}], ",", 
       RowBox[{"\"\<PC\>\"", "->", "pcFile"}], ",", 
       RowBox[{"\"\<OP\>\"", "->", "opFile"}], ",", 
       RowBox[{"\"\<Gap\>\"", "->", "gapFileMain"}]}], "|>"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"filesCheck", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"(", 
       RowBox[{"FileExistsQ", "/@", 
        RowBox[{"Values", "[", "mainFiles", "]"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", "filesCheck"}], ",", 
      RowBox[{
       RowBox[{
       "Print", 
        "[", "\"\<ERROR: One or more required CSV files are missing.\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "/@", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Values", "[", "mainFiles", "]"}], ",", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"FileExistsQ", "[", "#", "]"}]}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rowsIC", "=", 
     RowBox[{"importCSVRows", "[", "icFile", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rowsMallows", "=", 
     RowBox[{"importCSVRows", "[", "mallowsFile", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rowsPC", "=", 
     RowBox[{"importCSVRows", "[", "pcFile", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rowsOP", "=", 
     RowBox[{"importCSVRows", "[", "opFile", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rowsGap", "=", 
     RowBox[{"importCSVRows", "[", "gapFileMain", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Standard", " ", "runner", " ", 
     RowBox[{"produces", ":", 
      RowBox[{
      "6", " ", "rules", " ", "x", " ", "8", " ", "metrics", " ", "per", " ", 
       "setting", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"5", " ", "scalar", " ", "metrics"}], "+", "Top1"}], ",", 
         "Top2", ",", "Top3"}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"expectedRowCounts", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<IC\>\"", "->", 
        RowBox[{"4", "*", "6", "*", "8"}]}], ",", 
       RowBox[{"\"\<Mallows\>\"", "->", 
        RowBox[{"4", "*", "6", "*", "8"}]}], ",", 
       RowBox[{"\"\<PC\>\"", "->", 
        RowBox[{"44", "*", "6", "*", "8"}]}], ",", 
       RowBox[{"\"\<OP\>\"", "->", 
        RowBox[{"44", "*", "6", "*", "8"}]}], ",", 
       RowBox[{"\"\<Gap\>\"", "->", 
        RowBox[{"48", "*", "6"}]}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"actualRowCounts", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<IC\>\"", "->", 
        RowBox[{"Length", "[", "rowsIC", "]"}]}], ",", 
       RowBox[{"\"\<Mallows\>\"", "->", 
        RowBox[{"Length", "[", "rowsMallows", "]"}]}], ",", 
       RowBox[{"\"\<PC\>\"", "->", 
        RowBox[{"Length", "[", "rowsPC", "]"}]}], ",", 
       RowBox[{"\"\<OP\>\"", "->", 
        RowBox[{"Length", "[", "rowsOP", "]"}]}], ",", 
       RowBox[{"\"\<Gap\>\"", "->", 
        RowBox[{"Length", "[", "rowsGap", "]"}]}]}], "|>"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rowCountCheck", "=", 
     RowBox[{"actualRowCounts", "===", "expectedRowCounts"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"expectedRules", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"{", 
       RowBox[{"\"\<Borda\>\"", ",", "\"\<Plurality\>\"", 
        ",", "\"\<Coombs\>\"", ",", "\"\<QR\>\"", ",", "\"\<SDM\>\"", 
        ",", "\"\<Fallback\>\""}], "}"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rulesCheck", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sort", "@", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"rows", ",", "\"\<Rule\>\""}], "]"}], "]"}]}], "===", 
         "expectedRules"}], ",", 
        RowBox[{"{", 
         RowBox[{"rows", ",", 
          RowBox[{"{", 
           RowBox[{
           "rowsIC", ",", "rowsMallows", ",", "rowsPC", ",", "rowsOP", ",", 
            "rowsGap"}], "}"}]}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"mainMetricsExpected", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"{", 
       RowBox[{"\"\<NeverFirstRate\>\"", ",", "\"\<NoiseFlipRate\>\"", 
        ",", "\"\<CondorcetExistRate\>\"", ",", "\"\<CondorcetEfficiency\>\"",
         ",", "\"\<MidScore\>\"", ",", "\"\<Top1Acceptability\>\"", 
        ",", "\"\<Top2Acceptability\>\"", ",", "\"\<Top3Acceptability\>\""}], 
       "}"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"metricsCheck", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sort", "@", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"rows", ",", "\"\<Metric\>\""}], "]"}], "]"}]}], "===", 
         "mainMetricsExpected"}], ",", 
        RowBox[{"{", 
         RowBox[{"rows", ",", 
          RowBox[{"{", 
           RowBox[{
           "rowsIC", ",", "rowsMallows", ",", "rowsPC", ",", "rowsOP"}], 
           "}"}]}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"gapMetricCheck", "=", 
     RowBox[{
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Lookup", "[", 
        RowBox[{"rowsGap", ",", "\"\<Metric\>\""}], "]"}], "]"}], "===", 
      RowBox[{"{", "\"\<Gap\>\"", "}"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"numericCheck", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"And", "@@", 
         RowBox[{"(", 
          RowBox[{"NumericQ", "/@", 
           RowBox[{"Lookup", "[", 
            RowBox[{"rows", ",", "\"\<Value\>\""}], "]"}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"rows", ",", 
          RowBox[{"{", 
           RowBox[{
           "rowsIC", ",", "rowsMallows", ",", "rowsPC", ",", "rowsOP", ",", 
            "rowsGap"}], "}"}]}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"pipelineOK", "=", 
     RowBox[{"And", "[", 
      RowBox[{
      "filesCheck", ",", "rowCountCheck", ",", "rulesCheck", ",", 
       "metricsCheck", ",", "gapMetricCheck", ",", "numericCheck"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Expected row counts:       \>\"", ",", 
      "expectedRowCounts"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Actual row counts:         \>\"", ",", "actualRowCounts"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Row counts correct:        \>\"", ",", "rowCountCheck"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<All six rules present:     \>\"", ",", "rulesCheck"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Main metrics correct:      \>\"", ",", "metricsCheck"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Gap metric correct:        \>\"", ",", "gapMetricCheck"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<All values numeric:        \>\"", ",", "numericCheck"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<All CSV files exist:       \>\"", ",", "filesCheck"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<MAIN PIPELINE OK:           \>\"", ",", "pipelineOK"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
