    RowBox[{"{", 
     RowBox[{"\<\"Borda\"\>", ",", "\<\"Coombs\"\>", ",", "\<\"Fallback\"\>", 
      ",", "\<\"QR\"\>", ",", "\<\"SDM\"\>", ",", "\<\"Plurality\"\>"}], 
     "}"}]}], ",", 
   RowBox[{"\<\"BaseSeed\"\>", "\[Rule]", "123456"}], ",", 
   RowBox[{"\<\"TieBreak\"\>", "\[Rule]", "\<\"RandomSeeded\"\>"}]}], 
  "\[RightAssociation]"}]], "Print",
