       RowBox[{
        RowBox[{"(", "PC", ")"}], "--"}]}], "-"}]}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<Running main PC experiment...\>\"", "]"}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"resPCMain", "=", 
     RowBox[{"RunExperimentGrid", "[", 
      RowBox[{
       RowBox[{"\"\<Models\>\"", "->", 
        RowBox[{"{", "\"\<Polarized\>\"", "}"}]}], ",", 
       RowBox[{"\"\<mList\>\"", "->", "mListMain"}], ",", 
       RowBox[{"\"\<nList\>\"", "->", "nListMain"}], ",", 
       RowBox[{"\"\<phiList\>\"", "->", "phiListMain"}], ",", 
       RowBox[{"\"\<lambdaList\>\"", "->", "lambdaListMain"}], ",", 
       RowBox[{"\"\<qList\>\"", "->", "qListMain"}], ",", 
       RowBox[{"\"\<pList\>\"", "->", "pListMain"}], ",", 
       RowBox[{"\"\<S\>\"", "->", "Smain"}], ",", 
       RowBox[{"\"\<TopKList\>\"", "->", "topKListMain"}], ",", 
       RowBox[{"\"\<MaxRank\>\"", "->", "Automatic"}], ",", 
       RowBox[{"\"\<Parallel\>\"", "->", "useParallel"}], ",", 
       RowBox[{"\"\<BaseSeed\>\"", "->", "baseSeed"}], ",", 
       RowBox[{"\"\<TieBreak\>\"", "->", "tieBreakMain"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"dsPCMain", "=", 
     RowBox[{"ResultsToLongDataset", "[", "resPCMain", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Export", " ", "PC", " ", "long", " ", "dataset", " ", "as", " ", "a", " ",
      "standard", " ", "rectangular", " ", "CSV"}], "*)"}], 
   RowBox[{
    RowBox[{"pcFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"tabDir", ",", "\"\<main_pc_long.csv\>\""}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"pcRows", "=", 
     RowBox[{"Normal", "@", "dsPCMain"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pcColumns", "=", 
     RowBox[{"Keys", "@", 
      RowBox[{"First", "@", "pcRows"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"pcFile", ",", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"#", ",", "pcColumns"}], "]"}], "&"}], ")"}], "/@", 
         "pcRows"}], ",", "pcColumns"}], "]"}], ",", "\"\<CSV\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Saved CSV: \>\"", ",", "pcFile"}], "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"DumpSave", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"outDir", ",", "\"\<main_pc.mx\>\""}], "}"}], "]"}], ",", 
      "resPCMain"}], "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<PC completed. Settings = \>\"", ",", 
