Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "3"}]}], ")"}], " ", "Main", " ", 
    RowBox[{"experiment", ":", 
     RowBox[{
