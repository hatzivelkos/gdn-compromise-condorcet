Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "11"}]}], ")"}], " ", "Mallows", " ", "central"}], "-", 
    RowBox[{"winner", " ", 
     RowBox[{"robustness", ":", 
      RowBox[{
       RowBox[{"validate", " ", "and", " ", 
        RowBox[{"export", "--"}]}], "-"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Validating Mallows central-winner robustness \
sweep...\>\"", "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"expectedMallowsCentralRows", "=", 
     RowBox[{
      RowBox[{"Length", "[", "mallowsMList", "]"}], "*", 
      RowBox[{"Length", "[", "mallowsNList", "]"}], "*", 
      RowBox[{"Length", "[", "mallowsPhiList", "]"}], "*", 
      RowBox[{"Length", "[", "mallowsRules", "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"rowCountCheck", "=", 
     RowBox[{
      RowBox[{"Length", "[", "mallowsCentralRaw", "]"}], "===", 
      "expectedMallowsCentralRows"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"rulesCentralCheck", "=", 
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{"mallowsCentralRaw", ",", "\"\<Rule\>\""}], "]"}], "]"}]}], "===", 
      RowBox[{"Sort", "@", "mallowsRules"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"numericCentralCheck", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"(", 
       RowBox[{"NumericQ", "/@", 
        RowBox[{"Lookup", "[", 
         RowBox[{"mallowsCentralRaw", ",", "\"\<CentralWinnerRate\>\""}], 
         "]"}]}], ")"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"rangeCentralCheck", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"0", "<=", "#", "<=", "1"}], "&"}], "/@", 
        RowBox[{"Lookup", "[", 
         RowBox[{"mallowsCentralRaw", ",", "\"\<CentralWinnerRate\>\""}], 
         "]"}]}], ")"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"gridCentralCheck", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Count", "[", 
           RowBox[{"mallowsCentralRaw", ",", 
            RowBox[{"a_Association", "/;", 
             RowBox[{
              RowBox[{
               RowBox[{"a", "[", "\"\<m\>\"", "]"}], "==", "m"}], "&&", 
              RowBox[{
               RowBox[{"a", "[", "\"\<n\>\"", "]"}], "==", "n"}], "&&", 
              RowBox[{
               RowBox[{"a", "[", "\"\<phi\>\"", "]"}], "==", "phi"}]}]}]}], 
           "]"}], "==", 
          RowBox[{"Length", "[", "mallowsRules", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "mallowsMList"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "mallowsNList"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"phi", ",", "mallowsPhiList"}], "}"}]}], "]"}]}]}]}], ";"}],
    "\n", "\n", 
   RowBox[{
    RowBox[{"mallowsCentralOK", "=", 
     RowBox[{"And", "[", 
      RowBox[{
      "rowCountCheck", ",", "rulesCentralCheck", ",", "numericCentralCheck", ",",
        "rangeCentralCheck", ",", "gridCentralCheck"}], "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Expected rows:             \>\"", ",", 
      "expectedMallowsCentralRows"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Actual rows:               \>\"", ",", 
      RowBox[{"Length", "[", "mallowsCentralRaw", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Row count correct:         \>\"", ",", "rowCountCheck"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<All six rules present:     \>\"", ",", 
      "rulesCentralCheck"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<All rates numeric:         \>\"", ",", 
      "numericCentralCheck"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<All rates in [0,1]:        \>\"", ",", 
      "rangeCentralCheck"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Grid complete:             \>\"", ",", "gridCentralCheck"}],
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<MALLOWS CENTRAL SWEEP OK:  \>\"", ",", "mallowsCentralOK"}],
      "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"TrueQ", "[", "mallowsCentralOK", "]"}], ",", 
      RowBox[{
       RowBox[{"mallowsCentralFile", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"tabDir", ",", "\"\<mallows_central_support_long.csv\>\""}],
           "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mallowsCentralColumns", "=", 
        RowBox[{"Keys", "@", 
         RowBox[{"First", "@", "mallowsCentralRaw"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"mallowsCentralFile", ",", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"#", ",", "mallowsCentralColumns"}], "]"}], "&"}], 
             ")"}], "/@", "mallowsCentralRaw"}], ",", 
           "mallowsCentralColumns"}], "]"}], ",", "\"\<CSV\>\""}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Saved CSV: \>\"", ",", "mallowsCentralFile"}], "]"}], 
       ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
