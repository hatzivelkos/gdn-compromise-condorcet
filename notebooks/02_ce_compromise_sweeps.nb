            RowBox[{
             RowBox[{
              RowBox[{"#", "[", "\"\<Rule\>\"", "]"}], "===", "\"\<QR\>\""}], 
             "&"}]}], "]"}], ",", "\"\<q\>\""}], "]"}], "]"}]}], "===", 
      RowBox[{"Sort", "@", "qFig5"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sdmFig5Check", "=", 
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"fig5Rows", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", "\"\<Rule\>\"", "]"}], "===", "\"\<SDM\>\""}],
              "&"}]}], "]"}], ",", "\"\<p\>\""}], "]"}], "]"}]}], "===", 
      RowBox[{"Sort", "@", "pFig5"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numericFig5Check", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"(", 
       RowBox[{"NumericQ", "/@", 
        RowBox[{"Lookup", "[", 
         RowBox[{"fig5Rows", ",", "\"\<Value\>\""}], "]"}]}], ")"}]}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fig5SweepOK", "=", 
     RowBox[{"And", "[", 
      RowBox[{
      "rowCountFig5Check", ",", "lambdaFig5Check", ",", "rulesFig5Check", ",",
        "metricsFig5Check", ",", "qrFig5Check", ",", "sdmFig5Check", ",", 
       "numericFig5Check"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Expected rows:             \>\"", ",", "expectedFig5Rows"}],
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Actual rows:               \>\"", ",", 
      RowBox[{"Length", "[", "fig5Rows", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Lambda grid correct:       \>\"", ",", "lambdaFig5Check"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Rules correct:             \>\"", ",", "rulesFig5Check"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Metrics correct:           \>\"", ",", "metricsFig5Check"}],
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<QR parameter grid correct: \>\"", ",", "qrFig5Check"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<SDM parameter grid correct:\>\"", ",", "sdmFig5Check"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<All values numeric:        \>\"", ",", "numericFig5Check"}],
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<FIGURE 5 SWEEP OK:         \>\"", ",", "fig5SweepOK"}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"TrueQ", "[", "fig5SweepOK", "]"}], ",", 
      RowBox[{
       RowBox[{"fig5File", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
          "tabDir", ",", "\"\<op_midscore_parameter_sweep_long.csv\>\""}], 
          "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fig5Columns", "=", 
        RowBox[{"Keys", "@", 
         RowBox[{"First", "@", "fig5Rows"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"fig5File", ",", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"#", ",", "fig5Columns"}], "]"}], "&"}], ")"}], "/@", 
            "fig5Rows"}], ",", "fig5Columns"}], "]"}], ",", "\"\<CSV\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Saved CSV: \>\"", ",", "fig5File"}], "]"}], ";"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
