  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"3", ")"}], " ", "Format"}], ",", 
    RowBox[{
     RowBox[{
     "validate", " ", "and", " ", "export", " ", "paired", " ", "OP", " ", 
      "CE"}], "-", 
     RowBox[{"compromise", " ", "data"}]}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{"===", "===", "===", "===", 
    RowBox[{"==", "==="}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Formatting and validating paired OP sweep...\>\"", 
     "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"dsCELong", "=", 
     RowBox[{"ResultsToLongDatasetGapPaired", "[", "resCE", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ceRows", "=", 
     RowBox[{"Normal", "[", "dsCELong", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"expectedCERows", "=", 
     RowBox[{
      RowBox[{"Length", "[", "lambdaCE", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Length", "[", "qCE", "]"}], "+", 
        RowBox[{"Length", "[", "pCE", "]"}]}], ")"}], "*", "6"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"rowCountCECheck", "=", 
     RowBox[{
      RowBox[{"Length", "[", "ceRows", "]"}], "===", "expectedCERows"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"lambdaCECheck", "=", 
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{"ceRows", ",", "\"\<lambda\>\""}], "]"}], "]"}]}], "===", 
      RowBox[{"Sort", "@", "lambdaCE"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"rulesCECheck", "=", 
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{"ceRows", ",", "\"\<Rule\>\""}], "]"}], "]"}]}], "===", 
      RowBox[{"{", 
       RowBox[{"\"\<QR\>\"", ",", "\"\<SDM\>\""}], "}"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"metricsCECheck", "=", 
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{"ceRows", ",", "\"\<Metric\>\""}], "]"}], "]"}]}], "===", 
      RowBox[{"Sort", "@", 
       RowBox[{"{", 
        RowBox[{"\"\<Top1Acceptability\>\"", ",", "\"\<Top2Acceptability\>\"",
          ",", "\"\<Gap\>\"", ",", "\"\<CondorcetEfficiency\>\"", 
         ",", "\"\<CondorcetExistRate\>\"", ",", "\"\<MidScore\>\""}], 
        "}"}]}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"qrParameterCheck", "=", 
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"ceRows", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", "\"\<Rule\>\"", "]"}], "===", "\"\<QR\>\""}], 
