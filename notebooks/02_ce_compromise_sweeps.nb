            RowBox[{
             RowBox[{
              RowBox[{"#", "[", "\"\<Rule\>\"", "]"}], "===", "\"\<SDM\>\""}],
              "&"}]}], "]"}], ",", "\"\<p\>\""}], "]"}], "]"}]}], "===", 
      RowBox[{"Sort", "@", "pCE"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"numericValueCheck", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"(", 
