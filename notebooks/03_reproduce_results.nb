   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"fig2Rules", "=", "ruleOrder"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fig2M", "=", "7"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"fig2Rows", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Normal", "@", "dsMallowsCentral"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<m\>\"", "]"}], "==", "fig2M"}], "&"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"fig2Series", "=", 
     RowBox[{"Association", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"rule", "->", 
         RowBox[{"SortBy", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"N", "[", 
                 RowBox[{"#", "[", "\"\<phi\>\"", "]"}], "]"}], ",", 
                RowBox[{"N", "[", 
                 RowBox[{"#", "[", "\"\<CentralWinnerRate\>\"", "]"}], 
                 "]"}]}], "}"}], "&"}], ")"}], "/@", 
            RowBox[{"Select", "[", 
             RowBox[{"fig2Rows", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", "\"\<Rule\>\"", "]"}], "===", "rule"}], 
               "&"}]}], "]"}]}], ",", "First"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"rule", ",", "fig2Rules"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"fig2Check", "=", 
     RowBox[{"And", "@@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"fig2Series", "[", "rule", "]"}], "]"}], "==", "11"}], ",", 
        RowBox[{"{", 
         RowBox[{"rule", ",", "fig2Rules"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Figure 2 series complete: \>\"", ",", "fig2Check"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"fig2Plot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Values", "[", "fig2Series", "]"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"(", 
         RowBox[{"ruleStyles", "/@", "fig2Rules"}], ")"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{"fig2Rules", ",", "Right"}], "]"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Phi]\>\"", ",", "\"\<Central-winner rate\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"fig2File", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"figDir", ",", "\"\<figure2_mallows_central_winner.png\>\""}], 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"fig2File", ",", 
      RowBox[{"Rasterize", "[", 
       RowBox[{"fig2Plot", ",", 
        RowBox[{"ImageResolution", "->", "300"}]}], "]"}], 
      ",", "\"\<PNG\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Saved: \>\"", ",", "fig2File"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", "fig2Plot", "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
